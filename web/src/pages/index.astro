---
import content from "../modules/sum-project/data/content.json";
import Journey from "../modules/sum-project/components/Journey";
import Masthead from "../modules/sum-project/components/Masthead";
import "../modules/sum-project/styles/sum-project.css";
import "../modules/sum-project/styles/stepper.css";
import "../modules/sum-project/styles/story.css";
import "../modules/sum-project/styles/glossary.css";
import "../modules/sum-project/styles/road.css";
import "../modules/sum-project/styles/mission.css";
import "../modules/sum-project/styles/results.css";
const { meta } = content;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.subtitle} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@700;800&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" />
  </head>
  <body>
    <div class="app">
      <Masthead title={meta.title} subtitle={meta.subtitle} logo={meta.logo} />
      <Journey client:load content={content} />
    </div>
  </body>
</html>
